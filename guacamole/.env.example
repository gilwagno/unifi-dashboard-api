# Variáveis do docker-compose.yml do Guacamole (Onda 4 — Acesso Remoto).
# Copie para guacamole/.env e preencha. Esse arquivo NÃO é versionado.
#
#     cp guacamole/.env.example guacamole/.env
#     docker compose --env-file guacamole/.env up -d
#
# Deliberadamente separado do .env da raiz — ver a nota no topo do
# docker-compose.yml.

# Credenciais do Postgres que guarda as conexões do Guacamole.
# Gere a senha, não invente uma: openssl rand -base64 32
GUACAMOLE_DB_NAME=guacamole
GUACAMOLE_DB_USER=guacamole
GUACAMOLE_DB_PASSWORD=

# Porta local onde a interface/API do Guacamole responde. Publicada SÓ em
# 127.0.0.1 — quem alcança o Guacamole de fora é o dashboard, nunca a LAN.
GUACAMOLE_PORT=8080
