# Host/IP do seu controller UniFi (Cloud Key, UDM, UDR, etc.)
CONTROLLER_HOST=192.168.1.1

# Gerada em Settings > Control Plane > Integrations no controller
UNIFI_API_KEY=

# ID do site — o UUID retornado por GET /sites (campo "id"), NÃO a string
# "default" (isso é o internalReference, a API rejeita como siteId).
# Descubra o seu chamando GET /sites depois de configurar UNIFI_API_KEY.
SITE_ID=

# true se o controller usa certificado autoassinado (quase sempre o caso em rede local)
UNIFI_ALLOW_SELF_SIGNED=true

# --- API clássica/privada do controller (OPCIONAL) ---
# Necessária só para bloquear/desbloquear clientes de verdade (POST
# /clients/:mac/block e /unblock) e para o campo `blocked` de GET /clients
# vir preenchido corretamente. A Integration API oficial não suporta essas
# duas coisas para clientes comuns (só para guests) — ver README.
# São as credenciais do PAINEL do controller (o mesmo login que você usa
# para abrir a UI do UniFi Network), NÃO ADMIN_USER/ADMIN_PASSWORD_HASH
# abaixo (que são o login deste dashboard). Sem essas variáveis, o app
# sobe normalmente, mas block/unblock retorna 503.
# ATENÇÃO: é uma API não-documentada/privada — pode mudar sem aviso em
# atualizações de firmware do controller.
UNIFI_CONTROLLER_USER=
UNIFI_CONTROLLER_PASSWORD=
# internalReference do site pra API clássica (ex: "default") — DIFERENTE
# do SITE_ID (UUID) acima, usado pela Integration API. Normalmente
# "default" já funciona se você só tem um site.
UNIFI_CONTROLLER_SITE=default

# Segredo para assinar os JWT — troque por algo aleatório e longo
JWT_SECRET=troque-isto-por-algo-aleatorio-e-longo

# Login do dashboard
ADMIN_USER=admin
# Gere com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
ADMIN_PASSWORD_HASH=

PORT=3000

# Rate limiting (todos opcionais — os valores abaixo são os defaults)
# Janela compartilhada por todos os limites, formato aceito pelo
# @fastify/rate-limit (ex: "1 minute", "30 seconds")
RATE_LIMIT_WINDOW=1 minute
# Limite global de requisições por IP na janela acima
RATE_LIMIT_MAX=100
# Limite de POST /clients/:mac/block e /unblock
RATE_LIMIT_CLIENT_ACTION_MAX=10
# Limite de POST /devices/:id/restart
RATE_LIMIT_DEVICE_RESTART_MAX=5

# Arquivo do banco SQLite do módulo de manutenção de impressoras (cadastro,
# segredo SNMP, política de manutenção — ver src/db/printers.db.ts).
# Requer Node >= 22.5 (node:sqlite). Caminho relativo ao diretório onde o
# processo é iniciado.
PRINTERS_DB_FILE=./printers.db

# Arquivo do banco SQLite do histórico de banda de longo prazo (amostras
# finas 48h + rollup horário 30d — ver src/db/bandwidth-history.db.ts).
# Banco separado de PRINTERS_DB_FILE (domínios diferentes). Requer Node
# >= 22.5 (node:sqlite). Caminho relativo ao diretório onde o processo é
# iniciado.
BANDWIDTH_HISTORY_DB_FILE=./bandwidth-history.db

# Arquivo onde o log de auditoria de ações do dashboard é persistido
# (quem bloqueou um cliente, reiniciou um device, rotacionou a senha SSH,
# criou/removeu uma VLAN/SSID, etc. — ver GET /security/audit-log). Uma
# linha JSON por ação, criado automaticamente se não existir.
AUDIT_LOG_FILE=./audit.log

# --- Módulo de Active Directory (Onda 3, OPCIONAL — ver docs/ad-module-plan.md) ---
# Sem estas 5 variáveis, o módulo de AD fica indisponível (503), mas o
# resto do app funciona normalmente.
# URL LDAPS do domain controller — precisa ser ldaps:// (LDAP puro não é
# aceito: o AD recusa setar/trocar senha fora de uma conexão criptografada).
AD_URL=ldaps://dc.dominio.local:636
# DN base do domínio.
AD_BASE_DN=DC=dominio,DC=local
# DN da conta de serviço usada pro bind — precisa de permissão de escrita
# nos objetos que este módulo gerencia (criar/editar/excluir usuário,
# resetar senha, habilitar/desabilitar, add/remove de grupo).
AD_BIND_DN=CN=svc-dashboard,CN=Users,DC=dominio,DC=local
AD_BIND_PASSWORD=
# OU onde usuários novos são criados e onde a busca procura por padrão.
AD_USERS_OU=OU=Funcionarios,DC=dominio,DC=local
# DN do grupo que a ponte 802.1X usa como "tem acesso à rede" (NPS no
# Windows Server valida contra membership neste grupo). Só necessário para
# POST/DELETE /ad/users/:username/network-access — o resto do módulo
# funciona sem isto configurado.
AD_NETWORK_ACCESS_GROUP_DN=CN=Rede-Permitida,CN=Users,DC=dominio,DC=local
# Verificação de certificado TLS só da conexão LDAPS deste módulo (nunca um
# NODE_TLS_REJECT_UNAUTHORIZED global). Deixe "true" (padrão) contra um AD
# real — só existe para os testes de integração apontarem para o
# e2e/fake-ldap-server (certificado autoassinado).
AD_TLS_REJECT_UNAUTHORIZED=true
