node_modules/
dist/
.env
*.log

# Banco SQLite do módulo de impressoras (dev local e arquivos temporários
# de teste — ver src/db/printers.db.ts / PRINTERS_DB_FILE)
*.db
*.db-journal
*.db-wal
*.db-shm

# Playwright (e2e)
test-results/
playwright-report/
blob-report/
.playwright/
# Screenshots tiradas por rodadas de verificação manual/agente dentro de e2e/
# (o `.` no início é a convenção já usada por e2e/.printers-e2e.db). São
# artefato de UMA execução, não parte da suíte — commitá-las só engorda o
# histórico com binário que ninguém relê.
e2e/.*.png

# Incremental do `tsc -b`. O do frontend cai em node_modules/.tmp (já
# ignorado), mas rodar `tsc -b` na raiz cria este aqui e ele apareceu em
# `git status` como não rastreado.
*.tsbuildinfo

# Worktrees isolados criados pelo Agent tool (isolation: 'worktree') — cada
# um é um checkout completo do repo; nunca devem ser versionados, e um que
# fique órfão em disco não deve poluir `git status`/`git add -A` por engano
# (achado real em 2026-09-08 — ver vitest.config.ts pra exclusão da suíte).
.claude/worktrees/

# Retrato local da sonda de MIB privada Brother (tools/brother-mib-probe.mjs) —
# dado de equipamento real, capturado por operador; nao versionar.
tools/.brother-mib-snapshot.json

# Certificados de CA interna (especificos do ambiente, nao versionar)
.certs/
